{
  "name": "place-to-stand",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo lint && pts-lint scripts e2e && node scripts/design-tokens.mjs --check && node scripts/permissions-manifest.mjs --check && node scripts/check-entities.mjs && node scripts/check-rule-guards.mjs",
    "design-tokens": "node scripts/design-tokens.mjs",
    "permissions-manifest": "node scripts/permissions-manifest.mjs",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "cli:link": "npm run build -w @pts/cli && cd packages/cli && npm link",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "prepare": "husky",
    "knip": "DATABASE_URL=${DATABASE_URL:-postgres://localhost/knip} knip"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@pts/lint-config": "^0.1.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26"
  }
}
