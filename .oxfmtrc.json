{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "trailingComma": "es5",
  "bracketSpacing": true,
  "semi": false,
  "tabWidth": 2,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": { "functions": ["cn", "clsx"] },
  "ignorePatterns": [
    "docs/design-system/tokens.json",
    "apps/internal/lib/auth/permissions-manifest.json",
    "package-lock.json",
    "**/drizzle/**",
    "**/.next/**",
    "**/dist/**",
    ".claude/pts-session-log.json",
    "**/lint-suppressions.json"
  ]
}
