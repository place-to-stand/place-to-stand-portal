APP_BASE_URL=http://localhost:3001
NODE_ENV=development

# Full URL of the internal portal; invoice payment hands off to its shared
# invoice page.
INTERNAL_PORTAL_URL=http://localhost:3000


################
#   SUPABASE   #
################

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


################
#    RESEND    #
################

# Optional locally: outside production, auth email goes to Mailpit and needs
# no Resend credentials.
RESEND_API_KEY=
RESEND_FROM_EMAIL=portal@send.placetostandagency.com
RESEND_REPLY_TO_EMAIL=hello@placetostandagency.com


###############
#   POSTHOG   #
###############

# Same project as the internal portal; $host tells the apps apart. Capture
# only runs in production builds, and is skipped when the key is blank.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
DISABLE_POSTHOG_UPLOAD_SOURCEMAPS=true


################
#  GITHUB APP  #
################

# Only the GitHub App routes read these; the rest of the portal boots without
# them.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
