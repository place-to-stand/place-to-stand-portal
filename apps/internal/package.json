{
  "name": "@pts/internal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:prod": "dotenv -e .env.local -e .env.prod -o -- next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "db:pull": "drizzle-kit pull --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:prod": "dotenv -e .env.prod -- drizzle-kit migrate --config drizzle.config.ts",
    "db:reset": "supabase db reset --workdir ../.. && npm run db:migrate",
    "smoke:ui": "tsx --require ./scripts/stub-styles.cjs scripts/smoke-render-ui.tsx"
  },
