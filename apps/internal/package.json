{
  "name": "@pts/internal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:prod": "dotenv -e .env.local -e .env.prod -o -- next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "pts-lint",
    "test": "tsx --test 'lib/**/*.test.mts'",
    "type-check": "next typegen && tsc7 --noEmit",
    "db:pull": "drizzle-kit pull --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:prod": "node ../../packages/db/scripts/migrate.mjs .env.prod",
    "db:reset": "supabase db reset --workdir ../.. && npm run db:migrate",
    "smoke:ui": "tsx --require ./scripts/stub-styles.cjs scripts/smoke-render-ui.tsx"
  },
