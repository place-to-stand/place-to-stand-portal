{
  "name": "@pts/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./hours": "./src/hours.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts",
    "./names": "./src/names.ts",
    "./client-state": "./src/client-state.ts",
    "./terms": "./src/terms.ts",
    "./uuid": "./src/uuid.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:prod": "node scripts/migrate.mjs ../../apps/internal/.env.prod",
    "type-check": "tsc --noEmit",
    "lint": "eslint --max-warnings=0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@pts/eslint-config": "^0.1.0",
    "dotenv": "^18.0.8",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
